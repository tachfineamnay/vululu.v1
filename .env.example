# ---------------------------------------------------------------------------
# Vululu AI — variables d'environnement requises (placeholders uniquement)
# Copier ce fichier vers .env puis renseigner localement. Ne jamais commiter .env.
# Liste provisoire : elle sera confirmée et versionnée en P0-0 (ADR stack).
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Base de données PostgreSQL (source de vérité)
DATABASE_URL=postgresql://vululu@127.0.0.1:55432/vululu_v0?schema=public
DATABASE_URL_TEST=postgresql://vululu@127.0.0.1:55432/vululu_v0_test?schema=public

# Stockage objet S3-compatible (artefacts et médias)
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=vululu-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Orchestration durable (Hatchet — validation P0-0)
HATCHET_CLIENT_HOST=localhost:7077
HATCHET_CLIENT_TOKEN=

# Transfert Postiz (après approbation uniquement)
POSTIZ_API_URL=
POSTIZ_API_KEY=

# Sessions et invitations
SESSION_SECRET=
INVITATION_TTL_HOURS=72

# MCP distant (mécanisme d'authentification à trancher)
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=

# Fournisseurs IA (liste provisoire, à confirmer par capability)
AI_PROVIDER_DEFAULT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Budgets et coûts (valeurs à fixer en P0-0)
MAX_RUN_COST_CENTS=0
COST_ALERT_THRESHOLD_CENTS=0
# ---------------------------------------------------------------------------
# V0 Fullstack sprint — local uniquement
# ---------------------------------------------------------------------------
V0_DEMO_EMAIL=demo@vululu.local
V0_DEMO_PASSWORD=change-me
API_PORT=3001
ARTIFACT_DIR=./data/artifacts

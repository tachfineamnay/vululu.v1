# ---------------------------------------------------------------------------
# Vululu AI — variables d'environnement requises (placeholders uniquement)
# Copier ce fichier vers .env puis renseigner localement. Ne jamais commiter .env.
# Liste provisoire : elle sera confirmée et versionnée en P0-0 (ADR stack).
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Base de données PostgreSQL (source de vérité)
DATABASE_URL=postgresql://vululu@127.0.0.1:55432/vululu_v0?schema=public
DATABASE_URL_TEST=postgresql://vululu@127.0.0.1:55432/vululu_v0_test?schema=public

# Stockage objet S3-compatible (artefacts et médias)
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=vululu-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Orchestration durable (Hatchet — validation P0-0)
HATCHET_CLIENT_HOST=localhost:7077
HATCHET_CLIENT_TOKEN=

# Transfert Postiz (après approbation uniquement)
POSTIZ_API_URL=
POSTIZ_API_KEY=

# Sessions et invitations
SESSION_SECRET=
INVITATION_TTL_HOURS=72

# MCP distant (mécanisme d'authentification à trancher)
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=

# Fournisseurs IA (liste provisoire, à confirmer par capability)
AI_PROVIDER_DEFAULT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Budgets et coûts (valeurs à fixer en P0-0)
MAX_RUN_COST_CENTS=0
COST_ALERT_THRESHOLD_CENTS=0
# ---------------------------------------------------------------------------
# V0 Fullstack sprint — local uniquement
# ---------------------------------------------------------------------------
V0_DEMO_EMAIL=demo@vululu.local
V0_DEMO_PASSWORD=change-me
API_PORT=3001
ARTIFACT_DIR=./data/artifacts
FFMPEG_PATH=
# V1-00 local bootstrap (no default secret)
V1_BOOTSTRAP_EMAIL=demo@vululu.local
V1_BOOTSTRAP_PASSWORD=
V1_WEB_PORT=3100
V1_API_PORT=3101

# C09: opt-in only. Server-side secrets, never NEXT_PUBLIC_ variables.
MEDIA_GENERATION_ENABLED=0
MEDIA_IMAGE_ENABLED=1
MEDIA_VIDEO_ENABLED=1
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=

# Read-only per-publication metrics; independent of publishing. Disabled by default.
POSTIZ_ANALYTICS_ENABLED=0

# F05: Stripe test by default. Live requires production and explicit activation. API secrets only.
BILLING_STRIPE_MODE=test
STRIPE_LIVE_CHECKOUT_ENABLED=0
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Parcours client F01. Sans expéditeur ni clé, les requêtes d'envoi renvoient 503.
# Expéditeur vérifié chez Resend, clé réservée à l'envoi, origine web canonique HTTPS en production.
ACCOUNT_EMAIL_FROM=
ACCOUNT_EMAIL_RESEND_API_KEY=
ACCOUNT_EMAIL_ORIGIN=http://localhost:3100

# F02 — Vertex AI optionnel (compte et budget autorisés dans ToolBroker).
# Tarifs plafonds configurés : micro-USD par jeton (USD par million de jetons).
ASSISTANT_VERTEX_ENABLED=0
ASSISTANT_VERTEX_PROJECT=
ASSISTANT_VERTEX_LOCATION=global
ASSISTANT_VERTEX_MODEL=gemini-2.5-flash-lite
ASSISTANT_VERTEX_INPUT_MICROUSD=
ASSISTANT_VERTEX_OUTPUT_MICROUSD=
# Worker seulement si ADC nécessite un fichier monté en lecture seule ; aucun JSON ici.
GOOGLE_APPLICATION_CREDENTIALS=

# F04 : API et worker Hatchet ; clé de chiffrement serveur (32 octets en base64).
# Les clés Postiz propres aux clients sont associées dans le calendrier, jamais ici.
POSTIZ_PUBLISH_ENABLED=0
PUBLISHING_ENCRYPTION_KEY=

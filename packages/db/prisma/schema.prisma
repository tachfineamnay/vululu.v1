generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  selfRegisteredAt DateTime?
  accountTokens AccountToken[]
  billingAccount BillingAccount?
  serviceTickets ServiceTicket[]
  resultEvents ResultEvent[]
  resultPreference ResultPreference?
  publishingConnections PublishingConnection[]
  executionAccount ExecutionAccount?
  contentItems ContentItem[]
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  contexts     BrandContext[]
  campaigns    Campaign[]
  assets       BrandAsset[]
  projects     Project[]
  sessions     Session[]
  invitations  Invitation[] @relation("InvitationCreator")
}

model AccountToken {
  tokenHash String   @id
  purpose   String
  email     String
  userId    String?
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([userId])
}

model BrandContext {
  offers ConfirmedOffer[]
  id             String   @id @default(cuid())
  userId         String
  name           String
  website        String?
  description    String
  audience       String?
  tone           String?
  colorPrimary   String   @default("#6C5CE7")
  colorSecondary String   @default("#00D2FF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  revisions      ContextRevision[]
  assets         BrandAsset[]

  @@index([userId])
}

model Campaign {
  contentItems ContentItem[]
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@index([userId])
}

model Project {
  assistantTurns AssistantTurn[]
  studioClock StudioClock?
  marketingRevisions MarketingRevision[]
  executionOperations ExecutionOperation[]
  creativeRevisions CreativeRevision[]
  contentItems ContentItem[]
  id          String   @id @default(cuid())
  userId      String
  contextId   String
  campaignId  String?
  title       String
  platform    String
  format      String
  objective   String
  usage       String   @default("organic")
  storyboardBriefVersion Int?
  assetsConfirmedAt       DateTime?
  assetsConfirmationDigest String?
  assetsConfirmation      Json?
  sceneDurationSeconds Int @default(2)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context     BrandContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  brief       Brief?
  messages    Message[]
  scenes      Scene[]
  characters  Character[]
  artifacts   Artifact[]
  jobs        ProductionJob[]
  jobRuns     JobRun[]
  assetSelections ProjectAssetSelection[]

  @@index([userId])
  @@index([contextId])
  @@index([campaignId])
}

model BrandAsset {
  id        String @id
  userId    String
  contextId String
  kind      String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   BrandContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  versions  BrandAssetVersion[]
  selections ProjectAssetSelection[]
  @@index([userId, contextId])
}

model BrandAssetVersion {
  generation MediaGeneration?
  id              String @id
  assetId         String
  version         Int
  name            String
  mimeType        String
  sizeBytes       Int
  sha256          String
  license         String
  provenance      String
  metadata        Json
  storageProvider String
  storageKey      String @unique
  state           String @default("staged")
  createdAt       DateTime @default(now())
  asset           BrandAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  selections      ProjectAssetSelection[]
  @@unique([assetId, version])
}

model ProjectAssetSelection {
  projectId      String
  assetId        String
  assetVersionId String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset          BrandAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  version        BrandAssetVersion @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  @@id([projectId, assetId])
  @@index([assetVersionId])
}

model Brief {
  id        String   @id @default(cuid())
  projectId String   @unique
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  version   Int      @default(1)
  settings  Json?
  confirmedVersion Int?
  confirmedChecksum String?
  confirmedBy String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions BriefRevision[]
}

model BriefRevision {
  id        String   @id @default(cuid())
  briefId   String
  version   Int
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  checksum  String
  settings  Json?
  createdAt DateTime @default(now())
  brief     Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, version])
  @@index([briefId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  role      String
  content   String
  proposal  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id           String         @id @default(cuid())
  projectId    String
  sceneKey     String
  position     Int
  title        String
  description  String
  durationSeconds Int @default(2)
  usesBriefDuration Boolean?
  characterKey String?
  createdAt    DateTime       @default(now())
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     SceneVersion[]

  @@unique([projectId, sceneKey])
  @@index([projectId])
}

model SceneVersion {
  id                String   @id @default(cuid())
  sceneId           String
  version           Int
  imagePath         String
  prompt            String
  checksum          String
  storageKey        String?
  storageProvider   String?
  mimeType          String?
  sizeBytes         BigInt?
  sha256            String?
  finalizationState String   @default("legacy")
  manifest          Json?
  createdAt         DateTime @default(now())
  scene             Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, version])
  @@index([sceneId])
  @@index([storageProvider, storageKey])
}

model Character {
  id           String   @id @default(cuid())
  projectId    String
  characterKey String
  name         String
  description  String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     CharacterVersion[]

  @@unique([projectId, characterKey])
}

model Artifact {
  id        String            @id @default(cuid())
  projectId String
  kind      String            @default("master")
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ArtifactVersion[]

  @@unique([projectId, kind])
}

model ArtifactVersion {
  id                String    @id @default(cuid())
  artifactId        String
  version           Int
  masterPath        String
  checksum          String
  qaStatus          String?
  qaReport          Json?
  storageKey        String?
  storageProvider   String?
  mimeType          String?
  sizeBytes         BigInt?
  sha256            String?
  finalizationState String    @default("legacy")
  manifest          Json?
  createdAt         DateTime  @default(now())
  artifact          Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approval          Approval?

  @@unique([artifactId, version])
  @@index([artifactId])
  @@index([storageProvider, storageKey])
}

model Approval {
  id                String          @id @default(cuid())
  artifactVersionId String          @unique
  approvedBy        String
  checksum          String
  invalidatedAt     DateTime?
  createdAt         DateTime        @default(now())
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  transfer          Transfer?
}

model Transfer {
  id         String   @id @default(cuid())
  approvalId String   @unique
  status     String   @default("submitted")
  provider   String   @default("postiz-mock")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
}

model ProductionJob {
  id        String   @id @default(cuid())
  jobRunId  String?  @unique
  projectId String
  type      String
  status    String   @default("queued")
  step      String   @default("queued")
  progress  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRun    JobRun?  @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  csrfHash   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("user")
  tokenHash String   @unique
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  creator   User     @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model ContextRevision {
  id        String       @id @default(cuid())
  contextId String
  version   Int
  checksum  String
  data      Json
  createdAt DateTime     @default(now())
  context   BrandContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, version])
  @@index([contextId])
}

model CharacterVersion {
  id          String    @id @default(cuid())
  characterId String
  version     Int
  name        String
  description String
  checksum    String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, version])
  @@index([characterId])
}

model JobRun {
  id        String    @id @default(cuid())
  projectId String
  type      String
  status    String    @default("queued")
  snapshot         Json?
  snapshotVersion  Int       @default(1)
  snapshotChecksum String?
  outputs          Json?
  outputsChecksum  String?
  workflowRunId    String?
  orchestrator     String?
  traceId          String?
  requestId        String?
  lastTransitionAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps            StepRun[]
  productionJob    ProductionJob?

  @@index([projectId])
}

model StepRun {
  id         String    @id @default(cuid())
  jobRunId   String
  name       String
  status     String    @default("pending")
  attempts   Int       @default(0)
  error      String?
  output     Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  jobRun     JobRun    @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@unique([jobRunId, name])
  @@index([jobRunId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  traceId    String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model CostEvent {
  id          String   @id @default(cuid())
  projectId   String?
  jobRunId    String?
  provider    String
  model       String?
  units       Int      @default(0)
  amountCents Int      @default(0)
  idempotencyKey String? @unique
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
model AgentDefinition {
  id                     String               @id @default(cuid())
  key                    String               @unique
  name                   String
  role                   String
  capabilityRequirements Json
  activeConfigVersionId  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  configs                AgentConfigVersion[]
}

model AgentConfigVersion {
  id           String          @id @default(cuid())
  agentId      String
  version      Int
  soul         String
  instructions String
  guardrails   Json
  checksum     String
  createdAt    DateTime        @default(now())
  agent        AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
}

model Provider {
  credential ProviderCredential?
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model ProviderCredential {
  providerId     String   @id
  encryptedValue String
  updatedBy      String
  updatedAt      DateTime @updatedAt
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Model {
  id               String   @id @default(cuid())
  providerId       String
  modelKey         String
  capabilityKeys   String[]
  quality          Int
  latencyMs        Int
  costCentsPerUnit Int
  license          String
  active           Boolean  @default(true)
  qualified        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelKey])
  @@index([providerId])
}

model RoutingDecision {
  id               String   @id @default(cuid())
  capabilityKey    String
  candidateModelIds String[]
  selectedModelId  String
  fallbackModelId  String?
  criteria         Json
  reason           String
  createdAt        DateTime @default(now())

  @@index([capabilityKey])
  @@index([createdAt])
}
// ---------------------------------------------------------------------------
// V1-01-D : orchestration durable, outbox, etat metier, routage fige.
// ---------------------------------------------------------------------------

model OrchestrationOutbox {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  jobRunId       String?
  kind           String
  payload        Json
  status         String    @default("pending")
  attempts        Int      @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  workflowRunId  String?
  traceId        String?
  requestId      String?
  dispatchedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([jobRunId])
}

model RunStateEvent {
  id         String   @id @default(cuid())
  jobRunId   String
  stepRunId  String?
  scope      String
  fromState  String?
  toState    String
  source     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([jobRunId, createdAt])
  @@index([jobRunId, scope])
}

model RunRoutingSnapshot {
  id                    String   @id @default(cuid())
  jobRunId              String   @unique
  agentDefinitionId     String?
  agentConfigVersionId  String?
  agentConfigChecksum   String?
  capabilityKey         String
  providerId            String?
  modelId               String?
  providerKey           String
  modelKey              String
  fallbackModelId       String?
  policy                Json
  decisionId            String?
  estimatedCents        Int      @default(0)
  actualCents           Int      @default(0)
  createdAt             DateTime @default(now())
}

model RunArtifact {
  id                String   @id @default(cuid())
  jobRunId          String   @unique
  artifactVersionId String
  masterVersion     Int
  checksum          String
  scenes            Json
  manifest          Json?
  storageProvider   String?
  createdAt         DateTime @default(now())

  @@index([artifactVersionId])
}

model ArtifactObject {
  id                String   @id @default(cuid())
  provider          String
  key               String
  contentType       String
  sizeBytes         BigInt
  sha256            String
  etag              String?
  state             String   @default("pending")
  jobRunId          String?
  sceneId           String?
  sceneVersionId    String?
  artifactVersionId String?
  manifest          Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  finalizedAt       DateTime?

  @@unique([provider, key])
  @@index([state])
  @@index([jobRunId])
  @@index([sha256])
}
// ---------------------------------------------------------------------------
// V1-01-F : rate limiting persistant, heartbeats workers et correlation.
// ---------------------------------------------------------------------------

model RateLimitCounter {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model WorkerHeartbeat {
  id         String   @id
  name       String
  status     String   @default("running")
  lastSeenAt DateTime @default(now())
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lastSeenAt])
}

// An offer exists only after explicit owner confirmation. No inferred offers.
model ConfirmedOffer {
  id String @id @default(cuid())
  contextId String
  name String
  context BrandContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  items ContentItem[]
  @@unique([contextId, name])
}

model ContentItem {
  id String @id
  userId String
  offerId String
  campaignId String?
  projectId String?
  title String
  audience String
  objective String
  status String
  plannedAt DateTime @db.Timestamptz(3)
  timeZone String
  variants Json
  archived Boolean @default(false)
  version Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer ConfirmedOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revisions ContentRevision[]
  @@index([userId, plannedAt])
}

model ContentRevision {
  creativeVersions CreativeRevision[]
  itemId String
  version Int
  requestId String
  digest String
  snapshot Json
  createdAt DateTime @default(now())
  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@id([itemId, version])
  @@unique([itemId, requestId])
}

model CreativeRevision {
  renderAttempts StudioRender[]
  mediaGenerations MediaGeneration[]
  publicationRequests PublicationRequest[]
  contentItemId String?
  contentVersion Int?
  calendarRevision ContentRevision? @relation(fields:[contentItemId,contentVersion],references:[itemId,version],onDelete:Restrict,map:"CreativeRevision_calendar_fkey")
  @@index([contentItemId,contentVersion])
  projectId String
  version Int
  spec Json
  manifest Json?
  label String?
  origin String?
  provenance Json?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([projectId, version])
}

// Account = authenticated Vululu user. Limits are cumulative cents, not a rolling estimate.
model ExecutionAccount {
  userId String @id
  limitCents Int
  reservedCents Int @default(0)
  spentCents Int @default(0)
  tools String[]
  enabled Boolean @default(false)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  operations ExecutionOperation[]
}

model ExecutionOperation {
  assistantTurn AssistantTurn?
  marketingResult MarketingRevision?
  id String @id
  accountId String
  projectId String
  key String
  digest String
  tool String
  revision Int
  state String
  costState String
  maxCents Int
  reportedCents Int?
  approvedBy String?
  correlationId String @unique
  claimUntil DateTime?
  notifyAfter DateTime @default(now())
  params Json?
  result Json?
  agentTurnId String?
  step Int?
  createdAt DateTime @default(now())
  account ExecutionAccount @relation(fields:[accountId],references:[userId],onDelete:Restrict)
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  @@unique([accountId,key])
  @@index([state,notifyAfter])
  @@index([state,claimUntil])
}

model PublishingConnection {
  id String @id
  ownerId String
  user User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  provider String
  platform String
  channel String
  displayName String?
  tokenCipher String
  hookCipher String
  expiresAt DateTime
  revoked Boolean @default(false)
  requests PublicationRequest[]
  @@unique([ownerId,provider,channel])
}
model PublicationRequest {
  measure PostMeasure?
  id String @id
  submitKey String @unique
  cancelKey String @unique
  connectionId String
  connection PublishingConnection @relation(fields:[connectionId],references:[id],onDelete:Restrict)
  projectId String
  revision Int
  creative CreativeRevision @relation(fields:[projectId,revision],references:[projectId,version],onDelete:Restrict)
  itemId String
  itemVersion Int
  state String @default("PREPARED")
  reason String?
  remoteId String?
  networkReceipt String?
  scheduledAt DateTime?
  events PublicationEvent[]
  @@unique([itemId,itemVersion,connectionId])
  @@unique([connectionId,remoteId])
}
model PublicationEvent {
  requestId String
  eventId String
  request PublicationRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  digest String
  createdAt DateTime @default(now())
  @@id([requestId,eventId])
}

model MarketingRevision {
  projectId String
  version Int
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  requestId String
  requestDigest String
  parentVersion Int?
  operationId String? @unique
  operation ExecutionOperation? @relation(fields:[operationId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  parent MarketingRevision? @relation("marketing_parent",fields:[projectId,parentVersion],references:[projectId,version],onDelete:Restrict,onUpdate:NoAction)
  children MarketingRevision[] @relation("marketing_parent")
  context Json
  recipe Json
  result Json
  digest String
  origin String
  reason String
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  @@id([projectId,version])
  @@unique([projectId,requestId])
}

model MediaGeneration {
 id String @id
 projectId String
 revision Int
 source CreativeRevision @relation(fields:[projectId,revision],references:[projectId,version],onDelete:Restrict)
 sceneKey String
 tool String
 provider String
 model String
 modelVersion String?
 parameters Json
 referenceSha String?
 remoteId String?
 state String
 cancelRequested Boolean @default(false)
 cancelSent Boolean @default(false)
 submittedAt DateTime?
 outputVersion String? @unique
 output BrandAssetVersion? @relation(fields:[outputVersion],references:[id],onDelete:Restrict)
 reportedCents Int?
 createdAt DateTime @default(now())
 @@index([projectId,createdAt])
}

model StudioClock {
 projectId String @id
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 cursor Int
 events StudioEvent[]
}
model StudioEvent {
 projectId String
 clock StudioClock @relation(fields:[projectId],references:[projectId],onDelete:Cascade)
 cursor Int
 kind String
 entity String
 state String
 createdAt DateTime @default(now())
 @@id([projectId,cursor])
}
model StudioRender {
 managed Boolean @default(false)
 leaseToken String?
 leaseUntil DateTime?
 attempts Int @default(0)
 id String @id @default(uuid())
 projectId String
 revision Int
 source CreativeRevision @relation(fields:[projectId,revision],references:[projectId,version],onDelete:Cascade)
 state String
 reason String?
 progress Int @default(0)
 cancelRequested Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([projectId,createdAt])
}

model ResultEvent {
  id BigInt @id @default(autoincrement())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  kind String
  subject String
  version Int?
  detail String
  at DateTime @default(now())
  @@index([userId,at])
  @@index([at])
}
model ResultPreference {
  userId String @id
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  reminders Boolean @default(false)
  dismissedWeek String?
  firstExport DateTime?
  firstPublication DateTime?
}

model PostMeasure {
  requestId String @id
  request PublicationRequest @relation(fields:[requestId], references:[id], onDelete:Cascade)
  source String
  retrievedAt DateTime
  impressions BigInt?
  engagement BigInt?
  clicks BigInt?
  @@index([retrievedAt])
}

model BillingControl {
 id String @id
 enabled Boolean @default(false)
 mode String @default("test")
}
model BillingProduct {
 id String @id
 mode String @default("test")
 name String
 currency String
 amount Int
 days Int
 regular Int
 premium Int
 imageUnits Int
 videoUnits Int
 features String[]
 terms String
 evidence String
 approvedBy String
 listed Boolean @default(true)
 createdAt DateTime @default(now())
 orders BillingOrder[]
 @@unique([id,mode], map: "billing_product_identity_mode")
}
model BillingAccount {
 userId String @id
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 suspended Boolean @default(false)
}
model BillingOrder {
 id String @id
 mode String @default("test")
 stripeAccount String?
 userId String
 productId String
 product BillingProduct @relation(fields:[productId,mode],references:[id,mode],onDelete:Restrict,onUpdate:NoAction,map:"billing_order_product_mode")
 requestKey String
 sessionId String? @unique
 intentId String? @unique
 state String @default("PENDING")
 refunded Int @default(0)
 refundReview Boolean @default(false)
 reviewThrough Int @default(0)
 paidAt DateTime?
 expiresAt DateTime?
 createdAt DateTime @default(now())
 receipts BillingReceipt[]
 usage BillingUse[]
 @@unique([userId,requestKey])
 @@index([userId,createdAt])
}
model BillingReceipt {
 id String @id
 orderId String
 order BillingOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
 kind String
 digest String
 createdAt DateTime @default(now())
}
model BillingUse {
 renderKey String?
 key String @id
 orderId String
 order BillingOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
 feature String
 bucket String
 units Int
 state String
 createdAt DateTime @default(now())
 closedAt DateTime?
 @@index([orderId])
}
model ServiceTicket {
 id String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 kind String
 status String @default("OPEN")
 subject String
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now())
 entries TicketEntry[]
 @@index([userId,updatedAt])
}
model TicketEntry {
 id String @id
 ticketId String
 ticket ServiceTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
 role String
 status String
 message String
 createdAt DateTime @default(now())
 @@index([ticketId,createdAt])
}

model AssistantTurn {
  id              String    @id
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          AssistantTurn? @relation("assistant_parent", fields: [parentId], references: [id], onDelete: SetNull)
  children        AssistantTurn[] @relation("assistant_parent")
  operationId     String?   @unique
  operation       ExecutionOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  kind            String
  revision        Int
  request         Json
  inputDigest     String
  snapshot        Json
  providerProfile String?
  result          Json?
  digest          String?
  origin          String?
  reason          String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([parentId])
}

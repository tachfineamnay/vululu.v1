generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  contexts     BrandContext[]
  projects     Project[]
  sessions     Session[]
  invitations  Invitation[] @relation("InvitationCreator")
}

model BrandContext {
  id             String   @id @default(cuid())
  userId         String
  name           String
  website        String?
  description    String
  audience       String?
  tone           String?
  colorPrimary   String   @default("#6C5CE7")
  colorSecondary String   @default("#00D2FF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  revisions      ContextRevision[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  contextId   String
  title       String
  platform    String
  format      String
  objective   String
  sceneDurationSeconds Int @default(2)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context     BrandContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  brief       Brief?
  messages    Message[]
  scenes      Scene[]
  characters  Character[]
  artifacts   Artifact[]
  jobs        ProductionJob[]
  jobRuns     JobRun[]

  @@index([userId])
  @@index([contextId])
}

model Brief {
  id        String   @id @default(cuid())
  projectId String   @unique
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions BriefRevision[]
}

model BriefRevision {
  id        String   @id @default(cuid())
  briefId   String
  version   Int
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  checksum  String
  createdAt DateTime @default(now())
  brief     Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, version])
  @@index([briefId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  role      String
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id           String         @id @default(cuid())
  projectId    String
  sceneKey     String
  position     Int
  title        String
  description  String
  durationSeconds Int @default(2)
  characterKey String?
  createdAt    DateTime       @default(now())
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     SceneVersion[]

  @@unique([projectId, sceneKey])
  @@index([projectId])
}

model SceneVersion {
  id                String   @id @default(cuid())
  sceneId           String
  version           Int
  imagePath         String
  prompt            String
  checksum          String
  storageKey        String?
  storageProvider   String?
  mimeType          String?
  sizeBytes         BigInt?
  sha256            String?
  finalizationState String   @default("legacy")
  manifest          Json?
  createdAt         DateTime @default(now())
  scene             Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, version])
  @@index([sceneId])
  @@index([storageProvider, storageKey])
}

model Character {
  id           String   @id @default(cuid())
  projectId    String
  characterKey String
  name         String
  description  String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     CharacterVersion[]

  @@unique([projectId, characterKey])
}

model Artifact {
  id        String            @id @default(cuid())
  projectId String
  kind      String            @default("master")
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ArtifactVersion[]

  @@unique([projectId, kind])
}

model ArtifactVersion {
  id                String    @id @default(cuid())
  artifactId        String
  version           Int
  masterPath        String
  checksum          String
  qaStatus          String?
  qaReport          Json?
  storageKey        String?
  storageProvider   String?
  mimeType          String?
  sizeBytes         BigInt?
  sha256            String?
  finalizationState String    @default("legacy")
  manifest          Json?
  createdAt         DateTime  @default(now())
  artifact          Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approval          Approval?

  @@unique([artifactId, version])
  @@index([artifactId])
  @@index([storageProvider, storageKey])
}

model Approval {
  id                String          @id @default(cuid())
  artifactVersionId String          @unique
  approvedBy        String
  checksum          String
  invalidatedAt     DateTime?
  createdAt         DateTime        @default(now())
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  transfer          Transfer?
}

model Transfer {
  id         String   @id @default(cuid())
  approvalId String   @unique
  status     String   @default("submitted")
  provider   String   @default("postiz-mock")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
}

model ProductionJob {
  id        String   @id @default(cuid())
  jobRunId  String?  @unique
  projectId String
  type      String
  status    String   @default("queued")
  step      String   @default("queued")
  progress  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRun    JobRun?  @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  csrfHash   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("user")
  tokenHash String   @unique
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  creator   User     @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model ContextRevision {
  id        String       @id @default(cuid())
  contextId String
  version   Int
  checksum  String
  data      Json
  createdAt DateTime     @default(now())
  context   BrandContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, version])
  @@index([contextId])
}

model CharacterVersion {
  id          String    @id @default(cuid())
  characterId String
  version     Int
  name        String
  description String
  checksum    String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, version])
  @@index([characterId])
}

model JobRun {
  id        String    @id @default(cuid())
  projectId String
  type      String
  status    String    @default("queued")
  snapshot         Json?
  snapshotVersion  Int       @default(1)
  snapshotChecksum String?
  outputs          Json?
  outputsChecksum  String?
  workflowRunId    String?
  orchestrator     String?
  lastTransitionAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps            StepRun[]
  productionJob    ProductionJob?

  @@index([projectId])
}

model StepRun {
  id         String    @id @default(cuid())
  jobRunId   String
  name       String
  status     String    @default("pending")
  attempts   Int       @default(0)
  error      String?
  output     Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  jobRun     JobRun    @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@unique([jobRunId, name])
  @@index([jobRunId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model CostEvent {
  id          String   @id @default(cuid())
  projectId   String?
  jobRunId    String?
  provider    String
  model       String?
  units       Int      @default(0)
  amountCents Int      @default(0)
  idempotencyKey String? @unique
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
model AgentDefinition {
  id                     String               @id @default(cuid())
  key                    String               @unique
  name                   String
  role                   String
  capabilityRequirements Json
  activeConfigVersionId  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  configs                AgentConfigVersion[]
}

model AgentConfigVersion {
  id           String          @id @default(cuid())
  agentId      String
  version      Int
  soul         String
  instructions String
  guardrails   Json
  checksum     String
  createdAt    DateTime        @default(now())
  agent        AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
}

model Provider {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model Model {
  id               String   @id @default(cuid())
  providerId       String
  modelKey         String
  capabilityKeys   String[]
  quality          Int
  latencyMs        Int
  costCentsPerUnit Int
  license          String
  active           Boolean  @default(true)
  qualified        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelKey])
  @@index([providerId])
}

model RoutingDecision {
  id               String   @id @default(cuid())
  capabilityKey    String
  candidateModelIds String[]
  selectedModelId  String
  fallbackModelId  String?
  criteria         Json
  reason           String
  createdAt        DateTime @default(now())

  @@index([capabilityKey])
  @@index([createdAt])
}
// ---------------------------------------------------------------------------
// V1-01-D : orchestration durable, outbox, etat metier, routage fige.
// ---------------------------------------------------------------------------

model OrchestrationOutbox {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  jobRunId       String?
  kind           String
  payload        Json
  status         String    @default("pending")
  attempts        Int      @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  workflowRunId  String?
  dispatchedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([jobRunId])
}

model RunStateEvent {
  id         String   @id @default(cuid())
  jobRunId   String
  stepRunId  String?
  scope      String
  fromState  String?
  toState    String
  source     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([jobRunId, createdAt])
  @@index([jobRunId, scope])
}

model RunRoutingSnapshot {
  id                    String   @id @default(cuid())
  jobRunId              String   @unique
  agentDefinitionId     String?
  agentConfigVersionId  String?
  agentConfigChecksum   String?
  capabilityKey         String
  providerId            String?
  modelId               String?
  providerKey           String
  modelKey              String
  fallbackModelId       String?
  policy                Json
  decisionId            String?
  estimatedCents        Int      @default(0)
  actualCents           Int      @default(0)
  createdAt             DateTime @default(now())
}

model RunArtifact {
  id                String   @id @default(cuid())
  jobRunId          String   @unique
  artifactVersionId String
  masterVersion     Int
  checksum          String
  scenes            Json
  manifest          Json?
  storageProvider   String?
  createdAt         DateTime @default(now())

  @@index([artifactVersionId])
}

model ArtifactObject {
  id                String   @id @default(cuid())
  provider          String
  key               String
  contentType       String
  sizeBytes         BigInt
  sha256            String
  etag              String?
  state             String   @default("pending")
  jobRunId          String?
  sceneId           String?
  sceneVersionId    String?
  artifactVersionId String?
  manifest          Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  finalizedAt       DateTime?

  @@unique([provider, key])
  @@index([state])
  @@index([jobRunId])
  @@index([sha256])
}

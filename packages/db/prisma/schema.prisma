generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  contexts     BrandContext[]
  projects     Project[]
  sessions     Session[]
  invitations  Invitation[] @relation("InvitationCreator")
}

model BrandContext {
  id             String   @id @default(cuid())
  userId         String
  name           String
  website        String?
  description    String
  audience       String?
  tone           String?
  colorPrimary   String   @default("#6C5CE7")
  colorSecondary String   @default("#00D2FF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  revisions      ContextRevision[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  contextId   String
  title       String
  platform    String
  format      String
  objective   String
  sceneDurationSeconds Int @default(2)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context     BrandContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  brief       Brief?
  messages    Message[]
  scenes      Scene[]
  characters  Character[]
  artifacts   Artifact[]
  jobs        ProductionJob[]
  jobRuns     JobRun[]

  @@index([userId])
  @@index([contextId])
}

model Brief {
  id        String   @id @default(cuid())
  projectId String   @unique
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions BriefRevision[]
}

model BriefRevision {
  id        String   @id @default(cuid())
  briefId   String
  version   Int
  objective String
  audience  String
  tone      String
  cta       String
  platform  String
  format    String
  checksum  String
  createdAt DateTime @default(now())
  brief     Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, version])
  @@index([briefId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  role      String
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id           String         @id @default(cuid())
  projectId    String
  sceneKey     String
  position     Int
  title        String
  description  String
  durationSeconds Int @default(2)
  characterKey String?
  createdAt    DateTime       @default(now())
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     SceneVersion[]

  @@unique([projectId, sceneKey])
  @@index([projectId])
}

model SceneVersion {
  id        String   @id @default(cuid())
  sceneId   String
  version   Int
  imagePath String
  prompt    String
  checksum  String
  createdAt DateTime @default(now())
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, version])
  @@index([sceneId])
}

model Character {
  id           String   @id @default(cuid())
  projectId    String
  characterKey String
  name         String
  description  String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     CharacterVersion[]

  @@unique([projectId, characterKey])
}

model Artifact {
  id        String            @id @default(cuid())
  projectId String
  kind      String            @default("master")
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ArtifactVersion[]

  @@unique([projectId, kind])
}

model ArtifactVersion {
  id         String    @id @default(cuid())
  artifactId String
  version    Int
  masterPath String
  checksum   String
  qaStatus   String?
  qaReport   Json?
  createdAt  DateTime  @default(now())
  artifact   Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approval   Approval?

  @@unique([artifactId, version])
  @@index([artifactId])
}

model Approval {
  id                String          @id @default(cuid())
  artifactVersionId String          @unique
  approvedBy        String
  checksum          String
  invalidatedAt     DateTime?
  createdAt         DateTime        @default(now())
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  transfer          Transfer?
}

model Transfer {
  id         String   @id @default(cuid())
  approvalId String   @unique
  status     String   @default("submitted")
  provider   String   @default("postiz-mock")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
}

model ProductionJob {
  id        String   @id @default(cuid())
  jobRunId  String?  @unique
  projectId String
  type      String
  status    String   @default("queued")
  step      String   @default("queued")
  progress  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRun    JobRun?  @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  csrfHash   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("user")
  tokenHash String   @unique
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  creator   User     @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model ContextRevision {
  id        String       @id @default(cuid())
  contextId String
  version   Int
  checksum  String
  data      Json
  createdAt DateTime     @default(now())
  context   BrandContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, version])
  @@index([contextId])
}

model CharacterVersion {
  id          String    @id @default(cuid())
  characterId String
  version     Int
  name        String
  description String
  checksum    String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, version])
  @@index([characterId])
}

model JobRun {
  id        String    @id @default(cuid())
  projectId String
  type      String
  status    String    @default("queued")
  snapshot         Json?
  snapshotVersion  Int       @default(1)
  snapshotChecksum String?
  outputs          Json?
  outputsChecksum  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps            StepRun[]
  productionJob    ProductionJob?

  @@index([projectId])
}

model StepRun {
  id         String    @id @default(cuid())
  jobRunId   String
  name       String
  status     String    @default("pending")
  attempts   Int       @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  jobRun     JobRun    @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@unique([jobRunId, name])
  @@index([jobRunId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model CostEvent {
  id          String   @id @default(cuid())
  projectId   String?
  jobRunId    String?
  provider    String
  model       String?
  units       Int      @default(0)
  amountCents Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
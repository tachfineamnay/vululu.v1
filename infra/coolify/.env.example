# Vululu V1 — variables Coolify (modele .env.example SANS secret)
# Copier dans Coolify (Environment Variables) ou dans un fichier local ignore.
# Ne jamais committer de valeur reelle.

# Mode démo : aucune clé IA ; credentials seulement pour le bootstrap explicite.
DEMO_MODE=1
DEMO_EMAIL=demo@vululu.example
DEMO_PASSWORD=

# Recette uniquement (ADR 0028) — laisser 0 hors recette.
# RECETTE_ALLOW_SHORT_PASSWORDS=1 : autorise des mots de passe demo/admin non vides
#   de moins de 12 caracteres (72 octets maximum). Sans ce drapeau, demo-seed sort
#   en code 1 et le deploiement s'arrete avant l'API.
# RECETTE_RESET_PASSWORDS=1 : operation ponctuelle qui synchronise les hash des deux
#   comptes deja amorces et revoque leurs sessions. Remettre a 0 apres verification.
RECETTE_ALLOW_SHORT_PASSWORDS=0
RECETTE_RESET_PASSWORDS=0

# Domaine public (Coolify/Traefik) — le meme pour APP_ORIGIN et WEB_ORIGIN.
APP_ORIGIN=https://vululu.example.com
WEB_ORIGIN=https://vululu.example.com

# Secrets obligatoires (>= 32 caracteres pour SESSION_SECRET)
SESSION_SECRET=CHANGE_ME
# 32 octets aleatoires en base64 ; API uniquement, conserver pour les restaurations.
# Sans cette cle, la demo fonctionne mais l'enregistrement des cles IA est refuse.
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=
POSTGRES_USER=vululu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vululu

# Reseau interne : ne pas utiliser localhost.
DATABASE_URL=postgresql://vululu:CHANGE_ME@db:5432/vululu?schema=public
ALLOW_NON_LOCAL_DATABASE=1
API_HOST=0.0.0.0
API_PORT=3101
API_INTERNAL_URL=http://api:3101
TRUST_PROXY=true
SESSION_COOKIE_SECURE=1

# Orchestration : local pour un premier staging sans Hatchet, hatchet sinon.
ORCHESTRATOR_MODE=local
HATCHET_CLIENT_TOKEN=
HATCHET_PG_PASSWORD=
HATCHET_CLIENT_HOST_PORT=hatchet:17077
HATCHET_CLIENT_API_URL=http://hatchet:18243

# Stockage : local (volume artifacts) ou s3 (externe/manage).
ARTIFACT_STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_REQUIRE_TLS=0

# Bootstrap unique du super_admin (a retirer apres usage).
V1_BOOTSTRAP_EMAIL=admin@vululu.example
V1_BOOTSTRAP_PASSWORD=

# Tag d'image : tracabilite et reutilisation des images deja construites.
# Il ne selectionne PAS le commit deploye (Coolify importe la tete de branche et
# reconstruit depuis les sources). Doit rester aligne sur le commit reellement
# deploye, sinon les images portent un nom trompeur.
VULULU_IMAGE_TAG=latest
WEB_PORT=3100

# Preproduction locale Vululu V1 — placeholders uniquement, jamais commités.
# Copier vers infra/preprod/.env.preprod puis renseigner localement / via Coolify.

POSTGRES_PASSWORD=
HATCHET_PG_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# API (hors compose pour la Mission 05 ; voir runbook)
APP_ENV=production
APP_ORIGIN=https://staging.example.invalid
WEB_ORIGIN=https://staging.example.invalid
SESSION_SECRET=
SESSION_COOKIE_SECURE=1
ALLOW_NON_LOCAL_DATABASE=1
ORCHESTRATOR_MODE=hatchet
DATABASE_URL=postgresql://vululu:CHANGE_ME@postgres:5432/vululu?schema=public
HATCHET_CLIENT_HOST_PORT=hatchet:17077
HATCHET_CLIENT_API_URL=http://hatchet:18243
HATCHET_CLIENT_TLS_STRATEGY=none
ARTIFACT_STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3:9000
S3_REGION=us-east-1
S3_BUCKET=vululu-artifacts
S3_FORCE_PATH_STYLE=true
S3_REQUIRE_TLS=1
NODE_EXTRA_CA_CERTS=/certs/ca.crt
V1_BOOTSTRAP_EMAIL=
V1_BOOTSTRAP_PASSWORD=
